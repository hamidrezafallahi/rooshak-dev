# =============================================================================
# OnlineShop-Compose — local/dev env template (NO real secrets)
# Copy to `.env` and fill values. Never commit `.env`.
# docker-compose.dev.yml loads this file via env_file for every service.
# =============================================================================

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=OnlineShopDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── JWT / ASP.NET (Jwt__* is what the API reads) ───────────────────────────
JWT_KEY=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Key=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=OnlineShop
Jwt__Audience=OnlineShopUsers
JWT_ISSUER=OnlineShop
JWT_AUDIENCE=OnlineShopUsers

# ─── Backend (ASP.NET) ──────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
BACKEND_PORT=8080
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=OnlineShopDb;Username=postgres;Password=CHANGE_ME_STRONG_PASSWORD
Seed__AdminPassword=CHANGE_ME
Hangfire__DashboardEnabled=true
Backup__Directory=/src/Api/backups
Backup__PgDumpPath=pg_dump
ContentAutomation__AdminBaseUrl=http://localhost:3000
ContentAutomation__ServiceAccountName=Content Admin
ContentAutomation__ServiceAccountEmail=content-bot@onlineshop.local
ContentAutomation__ServiceAccountPassword=ContentBot@123
# P012: same random value for backend + n8n create workflow. Never commit the real key.
ContentAutomation__ApiKey=CHANGE_ME_LONG_RANDOM_CATALOG_API_KEY

# ─── Frontend (Next.js) ─────────────────────────────────────────────────────
NODE_ENV=development
INTERNAL_SERVER_SIDE_API_URL=http://backend:8080
NEXT_PUBLIC_SITE_URL=http://localhost
NEXT_PUBLIC_SITE_NAME=Rooshak

# ─── Docker / Nginx / Domain ────────────────────────────────────────────────
DOCKER_USERNAME=your-dockerhub-username
COMPOSE_PROJECT_NAME=shop
NGINX_PORT=80
NGINX_SSL_PORT=443
DOMAIN_NAME=localhost
CERTBOT_EMAIL=you@example.com
PORTAINER_PORT=9000

# ─── pgAdmin ────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME

# ─── n8n ────────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Tehran
TZ=Asia/Tehran
N8N_SECURE_COOKIE=false
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_LICENSE_KEY=

# ─── AI blog + SEO automation ───────────────────────────────────────────────
API_BASE_URL=http://backend:8080/api
CONTENT_BOT_EMAIL=content-bot@onlineshop.local
CONTENT_BOT_PASSWORD=ContentBot@123
CONTENT_BOT_NAME=Content Admin
CATALOG_API_KEY=CHANGE_ME_LONG_RANDOM_CATALOG_API_KEY
CONTENT_ADMIN_BASE_URL=http://localhost:3000
SEED_TOPICS_JSON=["ظروف کریستال","ظروف دکوری"]

# Free LLM: Groq — https://console.groq.com
GROQ_API_KEY=
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# SEO ops (backend health probes must reach these from inside Docker)
SeoOps__SitePublicUrl=http://nginx
SeoOps__ApiPublicUrl=http://backend:8080

# Optional Slack/Discord/generic webhook expecting JSON { "text": "..." }
SEO_ALERT_WEBHOOK_URL=
SEO_STALE_DAYS=90

# Recommended report channel (Iran-friendly): Telegram bot
# 1) @BotFather -> create bot -> TELEGRAM_BOT_TOKEN
# 2) message the bot, then get chat id via getUpdates -> TELEGRAM_CHAT_ID
# Used by SEO digests, orders digest, and P022 low-stock alerts.
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=CHANGE_ME_TELEGRAM_CHAT_ID
SHOP_OWNER_LOW_STOCK_URL=http://n8n:5678/webhook/shop-low-stock-alert
